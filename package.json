{
  "name": "ai-chat-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "serve": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p convex",
